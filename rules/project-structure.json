{
  "version": "1.1.0",
  "framework": "react",
  "target_root": "apps/frontend",
  "required_paths": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "vitest.config.ts",
    "index.html",
    ".env.example",
    "Dockerfile",
    "README.md",
    "public",
    "src/main.tsx",
    "src/app/App.tsx",
    "src/app/router.tsx",
    "src/app/providers.tsx",
    "src/app/styles.css",
    "src/routes/RootRoute.tsx",
    "src/routes/NotFoundRoute.tsx",
    "src/components/ui",
    "src/components/shared",
    "src/services/api-client.ts",
    "src/services/errors.ts",
    "src/lib/env.ts",
    "tests/setup.ts",
    "tests/e2e",
    "scripts/validate_project.mjs"
  ],
  "required_directories": [
    "public",
    "src/components/ui",
    "src/components/shared",
    "tests/e2e"
  ],
  "conditional_path_groups": [
    {
      "name": "realtime",
      "trigger_globs": ["src/realtime/client.ts", "src/features/*/hooks/useRealtime.ts"],
      "required_paths": ["src/realtime/client.ts", "src/realtime/events.ts", "src/realtime/state.ts", "src/realtime/client.test.ts", "tests/e2e/realtime.spec.ts"],
      "required_directories": [],
      "required_source_patterns": [
        {"id": "realtime-websocket-client", "globs": ["src/realtime/client.ts"], "pattern": "WebSocket", "ignore_case": false, "message": "React realtime requires a centralized WebSocket client."},
        {"id": "realtime-environment", "globs": [".env.example"], "pattern": "^VITE_REALTIME_WS_URL=", "ignore_case": false, "message": "The example environment must declare the realtime endpoint."}
      ]
    }
  ],
  "source_rules": [
    {"id": "no-reusable-token-in-websocket-url", "globs": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "(?:access_?token|jwt|bearer)=", "ignore_case": true, "scan_strings": true, "message": "Do not place reusable credentials in WebSocket URLs."},
    {"id": "no-approved-html-runtime-import", "globs": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "(?:HTML/approved|\\.html\\?raw)", "ignore_case": false, "scan_strings": true, "message": "Approved HTML is reference evidence and must not be imported into the production runtime."},
    {"id": "no-unsafe-html-injection", "globs": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "(?:dangerouslySetInnerHTML|\\.innerHTML\\b)", "ignore_case": false, "scan_strings": false, "message": "Compose semantic React elements instead of injecting HTML strings into the production DOM."}
  ],
  "feature_path_pattern": "src/features/<feature>",
  "module_path_pattern": "src/features/<module>",
  "module_naming": {
    "style": "kebab-case",
    "ambiguous_names": ["identity", "work", "operations", "data-management", "management", "collaboration"],
    "familiar_fallback_names": ["accounts", "authentications", "users", "notifications", "articles", "blog", "posts", "tasks", "todos", "webhooks", "chat", "files", "attachments", "payments", "orders", "products", "reports"],
    "responsibility_packages": [],
    "max_lines": [
      {"globs": ["*.tsx", "components/*.tsx", "hooks/*.ts", "hooks/*.tsx", "api/*.ts"], "maximum": 250}
    ]
  },
  "required_feature_paths": [
    "components",
    "hooks",
    "schemas.ts",
    "types.ts",
    "tests"
  ],
  "forbidden_patterns": [
    "backend business logic in browser code",
    "unvalidated network response",
    "secret in public environment value",
    "unlabelled interactive control",
    "application code copied from the behavior pack"
  ]
}
